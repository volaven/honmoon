{
  "name": "honmoon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chromium-native agent browser",
  "main": "dist/main/entry.cjs",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.ui.json && vite build && node scripts/build-mcp.mjs",
    "start": "node scripts/start.cjs",
    "dev": "npm run build && npm start",
    "test": "tsx --test tests/*.test.ts",
    "verify": "tsx scripts/verify.ts",
    "package": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "agent-browser": "0.38.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ws": "8.22.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
    "electron": "44.4.5",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.1"
  }
}
